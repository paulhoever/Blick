<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="blick">
  <schema id="io.github.paulhoever.Blick" path="/io/github/paulhoever/Blick/">
    <key name="window-width" type="i">
      <default>1100</default>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
    </key>
    <key name="last-folder" type="s">
      <default>""</default>
      <summary>Zuletzt geöffneter Ordner</summary>
    </key>
    <key name="library-roots" type="as">
      <default>[]</default>
      <summary>Ordner, die rekursiv als Bibliothek durchsucht werden</summary>
    </key>
    <key name="include-subfolders" type="b">
      <default>true</default>
      <summary>Kontaktbogen zeigt auch die Bilder aus Unterordnern</summary>
    </key>
    <key name="library-initialized" type="b">
      <default>false</default>
      <summary>Bilder-Ordner wurde beim ersten Start in die Bibliothek aufgenommen</summary>
    </key>
    <key name="color-scheme" type="s">
      <choices>
        <choice value="default"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>"default"</default>
      <summary>Farbschema: der Systemeinstellung folgen, hell oder dunkel</summary>
    </key>
    <key name="immich-expanded" type="b">
      <default>true</default>
      <summary>Immich-Alben in der Seitenleiste ausgeklappt</summary>
    </key>
    <key name="immich-url" type="s">
      <default>""</default>
      <summary>Adresse des Immich-Servers</summary>
      <description>Der API-Schlüssel liegt nicht hier, sondern im Schlüsselbund.</description>
    </key>
    <key name="dupes-locations" type="as">
      <default>[]</default>
      <summary>Orte der Dublettensuche, „R|“ oder „N|“ vor Pfad oder Adresse (Referenz oder normal)</summary>
    </key>
    <key name="dupes-immich" type="b">
      <default>false</default>
      <summary>Immich-Bibliothek in die Dublettensuche einbeziehen</summary>
    </key>
    <key name="dupes-mode" type="i">
      <default>0</default>
      <summary>Suchart der Dublettensuche (0 Bilder, 1 Inhalt, 2 Namen, 3 Ordner)</summary>
    </key>
    <key name="dupes-threshold" type="i">
      <default>95</default>
      <summary>Mindestähnlichkeit der Dublettensuche in Prozent</summary>
    </key>
    <key name="dupes-any-aspect" type="b">
      <default>false</default>
      <summary>Dublettensuche: auch unterschiedliche Seitenverhältnisse</summary>
    </key>
    <key name="dupes-rotation" type="b">
      <default>false</default>
      <summary>Dublettensuche: auch gedrehte Bilder</summary>
    </key>
  </schema>
</schemalist>
